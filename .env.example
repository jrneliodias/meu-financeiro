# Django Settings
SECRET_KEY=gere-uma-chave-secreta-aqui
DEBUG=false
ALLOWED_HOSTS=meu-financeiro.tec.br,www.meu-financeiro.tec.br

# CSRF (required for HTTPS)
CSRF_TRUSTED_ORIGINS=https://meu-financeiro.tec.br,https://www.meu-financeiro.tec.br

# Database - Supabase PostgreSQL (use pooler URL for IPv4)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Gemini AI (optional)
GEMINI_API_KEY=sua-api-key-aqui
